{
  "functions": {
    "api/index.php":  { "runtime": "vercel-php@0.7.1" },
    "api/submit.php": { "runtime": "vercel-php@0.7.1" },
    "api/db-check.php": { "runtime": "vercel-php@0.7.1" }
  },
  "rewrites": [
    { "source": "/submit.php",      "destination": "/api/submit.php"   },
    { "source": "/db-check",        "destination": "/api/db-check.php" },
    { "source": "/((?!assets/).*)", "destination": "/api/index.php"    }
  ]
}
